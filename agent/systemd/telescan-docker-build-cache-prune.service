[Unit]
Description=Prune stale Telescan Docker build cache
After=docker.service
Requires=docker.service
ConditionPathExists=/etc/default/telescan-monitoring-agent

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/telescan-docker-build-cache-prune
User=ubuntu
Group=ubuntu
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/docker.sock /tmp
