[Unit]
Description=Export Telescan central monitoring host operational state
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/telescan-monitoring-state
User=root
Group=root
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/telescan-monitoring/alloy/textfile
